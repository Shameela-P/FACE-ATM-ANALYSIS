# ==========================================
# Face Authentication & Customer Transaction System
# Environment Configuration Template (.env.example)
# ==========================================

# ------------------------------------------
# Frontend Variables (SvelteKit / Vite)
# ------------------------------------------
# These are client-side public Firebase credentials.
# Replace these with your Firebase Web App configuration values from the Firebase Console.
VITE_FIREBASE_API_KEY=AIzaSyAedUN6B2xOjgJsvpEL1R_aiXY4pV12JBA
VITE_FIREBASE_AUTH_DOMAIN=face-76a11.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=face-76a11
VITE_FIREBASE_STORAGE_BUCKET=face-76a11.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=981118590426
VITE_FIREBASE_APP_ID=1:981118590426:web:c05f36b38fc65fee0834e3
VITE_BACKEND_API_URL=http://localhost:8000

# ------------------------------------------
# Backend Variables (FastAPI)
# ------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary Admin Email (Only this account is authorized as the system admin)
ADMIN_EMAIL=shameela5qts@gmail.com

# Firebase Admin SDK Configuration
# Optional: Path to Firebase service account private key JSON file.
# If not set, the backend falls back to ADC or Firebase project ID verification.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=serviceAccountKey.json

# Transactional Email API Configuration (Required on Render where SMTP ports are blocked)
EMAIL_PROVIDER=auto
# Option 1: Resend (Recommended) - https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
# In sandbox mode without custom domain, use 'onboarding@resend.dev'; with custom domain, use 'Face ATM <noreply@yourdomain.com>'
RESEND_FROM_EMAIL=onboarding@resend.dev
# Option 2: Brevo - https://brevo.com
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# EMAIL_FROM=your_email@gmail.com

# Phase 2 Biometrics & Encryption
DATA_ENCRYPTION_KEY=your_base64_32byte_encryption_key_here
FACE_MODELS_DIR=models
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
