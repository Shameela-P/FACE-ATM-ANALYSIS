# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary Operational Administrator Email
ADMIN_EMAIL=admin@faceatm.local

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=face-76a11
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=serviceAccountKey.json

# Transactional Email API Configuration (REQUIRED on Render / Cloud where outbound SMTP ports 25, 465, 587 are blocked)
# EMAIL_PROVIDER can be 'auto', 'resend', 'brevo', 'sendgrid', or 'smtp'.
EMAIL_PROVIDER=auto

# Option 1: Resend (Recommended for Render)
# Sign up at https://resend.com to obtain an API key. Free tier includes 3,000 emails/month.
RESEND_API_KEY=re_your_resend_api_key_here
# In sandbox mode without custom domain, use 'onboarding@resend.dev'; with custom domain, use 'Face ATM <noreply@yourdomain.com>'
RESEND_FROM_EMAIL=onboarding@resend.dev

# Option 2: Brevo (Alternative HTTP provider)
# Sign up at https://brevo.com to obtain an API key. Allows sending from any verified personal email (e.g. Gmail).
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# EMAIL_FROM=your_email@gmail.com

# Gmail SMTP Configuration (Used for local development or platforms where port 587 is open)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM=your_email@gmail.com

# Phase 2 Security & Biometrics
DATA_ENCRYPTION_KEY=your_base64_32byte_encryption_key_here
FACE_MODELS_DIR=models
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
